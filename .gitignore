# macOS
.DS_Store

# NOTE: this file is dev-role only. It governs the AMS repo, never an installed kit.
# The shipped payload lives in kit/ and carries no .gitignore of its own, so a project
# that installs AMS tracks its own HANDOFF/, DOC/, SPRINTS/ and LEARNINGS/ normally.
# Do not add component-directory rules here — AMS uses those names at root for its own
# journal (see CLAUDE.md), and ignoring them is what made AMS unable to record itself.

# Talk materials (not part of the framework)
presentation.md
session-description.md

# Persona image files not in repo
PERSONAS/source/
PERSONAS/opaque/
PERSONAS/trans/

# Sub-projects (each has its own repo)
agent-handoff/
agent-handoff-plugin/
agent-project-tracker/
tracktime/
claude-fact-check-skill/

# Examples
EXAMPLES/

# Outgoing artifacts (not for this repo)
OUTGOING/

# Root-level HTML files superseded by INTERFACE/
/daily-scrum.html
/office.html
/floorplan.html

# INTERFACE working/archive files (kept locally, not staged)
INTERFACE/daily-scrum-v1.html
INTERFACE/office-v1.html
INTERFACE/daily-scrum-v1 Large.jpeg
INTERFACE/scrum-idea-1.jpg

# Test installations of agent-scrum (each becomes its own repo)
AMS-TEST/
